# Multi-AI (all optional — offline oracle always works)
# Groq free tier: https://console.groq.com
VITE_GROQ_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# Google Gemini: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# OpenRouter (many models behind one key): https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=
# Optional model override, e.g. anthropic/claude-3.5-sonnet
VITE_OPENROUTER_MODEL=

# Optional — Supabase auth + realtime multiplayer
# https://supabase.com → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
